rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if request has a valid JWT claim matching uid
    // We use the Firebase Auth UID stored in documents to scope access.
    // The frontend uses the Firebase JS SDK with anonymous/custom token auth.
    // Since we use our own JWT (not Firebase Auth), we allow reads scoped by
    // document field matching — backend writes are trusted (Admin SDK bypasses rules).

    // USERS — each user can read their own doc; owners can read their team
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        resource.data.ownerId == request.auth.uid
      );
      allow write: if false; // backend only
    }

    // ORDERS — owner/accountant can read orders for their ownerId; salesman reads own
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.salesmanId == request.auth.uid
      );
      allow write: if false; // backend only
    }

    // NOTIFICATIONS — recipient can read/update their own
    match /notifications/{notifId} {
      allow read: if request.auth != null && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.recipientId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow write: if false; // backend only for create/delete
    }

    // DUTY SESSIONS — owner can read their sessions; salesman reads own
    match /dutySessions/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.salesmanId == request.auth.uid
      );
      allow write: if false;
    }

    // STOP EVENTS — owner can read their stop events
    match /stopEvents/{eventId} {
      allow read: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // LOCATION PINGS — owner can read pings for their salesmen
    match /locationPings/{pingId} {
      allow read: if request.auth != null &&
        resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }

    // Everything else — deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
